<Page x:Class="PokedexG.Uwp.Views.PokemonDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Template10.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls1="using:Microsoft.Toolkit.Uwp.UI.Controls"
      xmlns:viewModels="using:PokedexG.Uwp.ViewModels"
      xmlns:userControls="using:PokedexG.Uwp.Views.UserControls"
      xmlns:models="using:PokedexG.Uwp.Models"
      xmlns:rsc="using:PokemonAPI.Models.Rsc"
      mc:Ignorable="d">

    <Page.DataContext>
        <viewModels:PokemonDetailsPageViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Page.Resources>
        <DataTemplate x:Name="MoveItemTemplate" x:DataType="models:Move">
            <Grid BorderBrush="Bisque" BorderThickness="1" CornerRadius="5" Margin="0,10,20,10" Padding="10">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="150px" />
                    <ColumnDefinition Width="380px" />
                    <ColumnDefinition Width="50px" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                           Text="{x:Bind Level}" Width="50px" VerticalAlignment="Center" FontWeight="Bold"
                           FontSize="18" />
                <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" FontWeight="Bold" />
                    <TextBlock
                        Text="{x:Bind NameEn, Converter={StaticResource StringFormatConverter}, ConverterParameter='(\{0\})'}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                    <userControls:UserControlType TypeId="{x:Bind TypeId}" Text="{x:Bind Type}" />
                    <userControls:UserControlDamage DamageClassIdentifier="{x:Bind DamageClass}" Margin="4,0,0,0" />
                    <!--<TextBlock Text="{x:Bind Ailment}" Margin="4,0,0,0"/>-->
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold"
                               Text="{x:Bind Pp, Converter={StaticResource NullStringToPlaceholderConverter}, ConverterParameter='\{0\} PP'}" />
                    <TextBlock FontWeight="Bold"
                               Text="{x:Bind Power, Converter={StaticResource NullStringToPlaceholderConverter}}" />
                    <TextBlock FontWeight="Bold"
                               Text="{x:Bind Accuracy, Converter={StaticResource NullStringToPlaceholderConverter}, ConverterParameter='\{0\}%'}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" TextWrapping="Wrap"
                           Text="{x:Bind FlavorText}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <RelativePanel Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveVisualStateGroup">
                <VisualState x:Name="VisualStateNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource NarrowMinWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>

                        <!--  TODO: change properties for narrow view  -->

                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VisualStateNormal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource NormalMinWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>

                        <!--  TODO: change properties for normal view  -->

                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VisualStateWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideMinWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>

                        <!--  TODO: change properties for wide view  -->

                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  header  -->
        <controls:PageHeader x:Name="pageHeader" Frame="{x:Bind Frame}"
                             RelativePanel.AlignLeftWithPanel="True"
                             RelativePanel.AlignRightWithPanel="True"
                             RelativePanel.AlignTopWithPanel="True"
                             Text="Détails d'un Pokémon" />

        <Grid x:Name="DetailsHeader" Height="48" VerticalAlignment="Top"
              Background="{ThemeResource ButtonBackgroundThemeBrush}"
              RelativePanel.AlignLeftWithPanel="True"
              RelativePanel.AlignRightWithPanel="True"
              RelativePanel.Below="pageHeader">
            <StackPanel Orientation="Horizontal">
                <Border VerticalAlignment="Stretch" Width="48">
                    <Image
                        Source="{x:Bind ViewModel.Pokemon.FormKey, Converter={StaticResource FormKeyToIconPathConverter}}"
                        Width="40" Height="30" />
                </Border>
                <TextBlock
                    Text="{x:Bind ViewModel.Pokemon.PokedexNumberNationalFormatedWithSuffix, FallbackValue=#000}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    VerticalAlignment="Center" Margin="10,4,10,0" FontFamily="Segoe UI Semibold" FontSize="18" />
                <TextBlock
                    Text="{x:Bind ViewModel.Pokemon.NameFr, FallbackValue=PokemonNameFr, Mode=OneWay}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    VerticalAlignment="Center" FontWeight="Bold" FontFamily="Segoe UI Semibold" FontSize="18"
                    Margin="10,4,0,0" />
                <TextBlock Text="(fr)" FontSize="14" FontFamily="Segoe UI Semibold" VerticalAlignment="Top"
                           Margin="2,10,0,0" />
                <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                           Text="{x:Bind ViewModel.Pokemon.NameEn, FallbackValue=PokemonNameEn, Mode=OneWay}"
                           Margin="20,4,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" FontSize="18" />
                <TextBlock Text="(en)" FontSize="14" FontFamily="Segoe UI Semibold" VerticalAlignment="Top"
                           Margin="2,10,0,0" />
                <!--<TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.CurrentPokemon.NameJp, Mode=OneWay, FallbackValue=DesigntimeValue}" Margin="20,0,0,0" VerticalAlignment="Bottom"  />
                <TextBlock Text="(jp)"/>-->
            </StackPanel>
        </Grid>

        <Grid x:Name="MainGrid"
              RelativePanel.AlignLeftWithPanel="True"
              RelativePanel.AlignRightWithPanel="True"
              RelativePanel.AlignBottomWithPanel="True"
              RelativePanel.Below="DetailsHeader">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>


            <Grid BorderThickness="0,0,2,0" BorderBrush="Bisque">
                <StackPanel Margin="10,0,10,10">
                    <controls1:ImageEx
                        Source="{x:Bind ViewModel.Pokemon.FormKey, Converter={StaticResource SpecieIdToIllustrationPathConverter}}"
                        Width="300" Height="300" HorizontalAlignment="Left" Margin="0,20,0,0" />

                    <Grid HorizontalAlignment="Left" Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Type principal" Grid.Row="0" Grid.Column="0" FontWeight="Bold"
                                   Margin="0,7,0,0" VerticalAlignment="Top" />
                        <userControls:UserControlType2 Grid.Row="0" Grid.Column="1"
                                                      VerticalAlignment="Top" Margin="16,7,0,0"
                                                      HorizontalAlignment="Left"
                                                      PokemonType="{x:Bind ViewModel.Pokemon.Type1}"
                                                      Tapped="Type1_OnTapped" />
                        <TextBlock Text="Type secondaire" Grid.Row="1" Grid.Column="0" FontWeight="Bold"
                                   Margin="0,7,0,0" VerticalAlignment="Top"
                                   Visibility="{x:Bind ViewModel.Pokemon.Type2.Id, Converter={StaticResource NullToVisibilityConverter}}" />
                        <userControls:UserControlType2 Grid.Row="1" Grid.Column="1"
                                                      VerticalAlignment="Top" Margin="16,7,0,0"
                                                      HorizontalAlignment="Left"
                                                      PokemonType="{x:Bind ViewModel.Pokemon.Type2}"
                                                      Tapped="Type2_OnTapped"
                                                      Visibility="{x:Bind ViewModel.Pokemon.Type2.Id, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="Taux de capture" Grid.Row="2" Grid.Column="0" FontWeight="Bold"
                                   Margin="0,7,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Pokemon.CaptureRate}" Grid.Row="2"
                                   Grid.Column="1" Margin="16,7,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Ratio de genre" Grid.Row="3" Grid.Column="0" FontWeight="Bold"
                                   Margin="0,7,0,0" VerticalAlignment="Center" />
                        <userControls:UserControlGender Grid.Row="3" Grid.Column="1" Margin="16,7,0,0"
                                                        VerticalAlignment="Stretch"
                                                        GenderCode="{x:Bind ViewModel.Pokemon.GenderRate}"
                                                        HorizontalAlignment="Left" />
                        <TextBlock Text="Couleur" Grid.Row="4" Grid.Column="0" FontWeight="Bold" Margin="0,7,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Pokemon.Color}" Grid.Row="4"
                                   Grid.Column="1" Margin="16,7,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Taille" Grid.Row="5" Grid.Column="0" FontWeight="Bold" Margin="0,7,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Pokemon.HeightFormated}" Grid.Row="5"
                                   Grid.Column="1" Margin="16,7,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Poids" Grid.Row="6" Grid.Column="0" FontWeight="Bold" Margin="0,7,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Pokemon.WeightFormated}" Grid.Row="6"
                                   Grid.Column="1" Margin="16,7,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Espèces" Grid.Row="7" Grid.Column="0" FontWeight="Bold" Margin="0,7,0,0"
                                   VerticalAlignment="Top" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="16,7,0,0">
                            <TextBlock Text="{x:Bind ViewModel.Pokemon.Genus}" />
                            <TextBlock Text="{x:Bind ViewModel.Pokemon.ShapeName}" />
                        </StackPanel>
                        <TextBlock Text="Génération" Grid.Row="8" Grid.Column="0" FontWeight="Bold" Margin="0,7,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Pokemon.GenerationName}" Grid.Row="8"
                                   Grid.Column="1" Margin="16,7,0,0" VerticalAlignment="Center" />
                    </Grid>

                </StackPanel>
            </Grid>


            <Pivot Grid.Column="1">

                <PivotItem Header="Informations">
                    <ScrollViewer Margin="0,12,-12,0" HorizontalContentAlignment="Left"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="10,0,10,10">
                                <StackPanel x:Name="SectionDescriptions">
                                    <userControls:UserControlTitle Title="Description du Pokédex" />

                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,10">
                                        <TextBlock Text="Version :" VerticalAlignment="Center" />
                                        <RadioButton Content="X" Tag="X"
                                                     Command="{x:Bind ViewModel.SelectFlavorTextXCommand}"
                                                     Margin="10,0,0,0" IsChecked="True" FontWeight="Bold" />
                                        <RadioButton Content="Y" Tag="Y"
                                                     Command="{x:Bind ViewModel.SelectFlavorTextYCommand}"
                                                     Margin="-50,0,0,0" FontWeight="Bold" />
                                        <RadioButton Content="RΩ" Tag="RΩ"
                                                     Command="{x:Bind ViewModel.SelectFlavorTextOmegaRubyCommand}"
                                                     Margin="-50,0,0,0" FontWeight="Bold" />
                                        <RadioButton Content="Sα" Tag="Sα"
                                                     Command="{x:Bind ViewModel.SelectFlavorTextAlphaSapphireCommand}"
                                                     Margin="-50,0,0,0" FontWeight="Bold" />
                                    </StackPanel>
                                    <TextBlock Margin="10,0,0,20"
                                               Text="{x:Bind ViewModel.CurrentFlavorText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="SectionAbilities">
                                    <userControls:UserControlTitle Title="Talents" />

                                    <ListView ItemsSource="{x:Bind ViewModel.Pokemon.Abilities}" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:PokemonAbilityUiModel">
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{x:Bind Name}" FontWeight="Bold" />
                                                        <Run Text="{x:Bind IsHidden, Converter={StaticResource IsHiddenToTextConverter}}" />
                                                    </TextBlock>
                                                    <TextBlock TextWrapping="Wrap"
                                                               Text="{x:Bind ShortEffect, Converter={StaticResource StringToRemoveBreakConverter}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                                <StackPanel x:Name="SectionWeaknesses">
                                    <userControls:UserControlTitle Title="Faiblesses" />

                                    <GridView ItemsSource="{x:Bind ViewModel.Pokemon.Weaknesses}" SelectionMode="None"
                                              HorizontalAlignment="Left" MaxWidth="520">
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="models:DamageTypeUiModel">
                                                <StackPanel Orientation="Horizontal">
                                                    <userControls:UserControlWeakness Damage="{x:Bind}" Margin="5"
                                                                                      Tapped="WeaknessType_OnTapped" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10,0,10,10">
                                <StackPanel x:Name="SectionEvolutions">
                                    <userControls:UserControlTitle Title="Chaîne d'évolution" />

                                    <GridView ItemsSource="{x:Bind ViewModel.Family.EvolutionStades}"
                                              SelectionMode="None">
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="models:PokemonFamilyStade">
                                                <StackPanel Width="150" Tapped="Evolution_OnTapped">
                                                    <TextBlock Text="{x:Bind Name, FallbackValue='Stade 1'}"
                                                               FontWeight="Bold" HorizontalAlignment="Center" />
                                                    <ListView ItemsSource="{x:Bind Evolutions}" SelectionMode="None"
                                                              HorizontalAlignment="Center">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="models:PokemonEvolution">
                                                                <StackPanel>
                                                                    <Grid Height="150">
                                                                        <Image
                                                                            Source="{x:Bind PokemonId, Converter={StaticResource FormKeyToIconPathConverter}, Mode=OneTime}"
                                                                            Stretch="None" VerticalAlignment="Bottom"
                                                                            HorizontalAlignment="Center" />
                                                                        <!--<Image Source="{x:Bind PokemonId, Converter={StaticResource SpecieIdToSpritePathConverter}, Mode=OneTime}"
                                                                   Stretch="None" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>-->
                                                                    </Grid>
                                                                    <TextBlock Text="{x:Bind NameFr}" Margin="0,10,0,0"
                                                                               HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>
                                <StackPanel x:Name="SectionMegaEvolutions">
                                    <userControls:UserControlTitle Title="Méga évolutions" />

                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </PivotItem>

                <PivotItem Header="Statistiques">
                    <ScrollViewer Margin="0,12,-12,0" HorizontalContentAlignment="Left"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="SectionStatistics">
                                <userControls:UserControlTitle Title="Stats de base" />

                                <Grid HorizontalAlignment="Left" Height="300" Margin="10,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Pctile" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0" FontWeight="Bold" />
                                    <TextBlock Text="Min IVs" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0" FontWeight="Bold" />
                                    <TextBlock Text="Max IVs" Grid.Row="0" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0" FontWeight="Bold" />

                                    <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="10" BorderThickness="1,0,0,0" BorderBrush="Bisque"/>
                                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" BorderThickness="0,1,0,0" BorderBrush="Bisque"/>

                                    <TextBlock Text="P.V." Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                               FontWeight="Bold" Margin="0,0,4,0" />
                                    <ProgressBar Grid.Row="2" Grid.Column="1" Maximum="200"
                                                 Value="{x:Bind ViewModel.Pokemon.BaseStatHp}"
                                                 Width="200" Height="40" Margin="4" HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.BaseStatHp}" Grid.Row="2"
                                               Grid.Column="1"
                                               VerticalAlignment="Center" Margin="10,4,4,4" Foreground="White" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.MinStatHp}" Grid.Row="2"
                                               Grid.Column="2"
                                               VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.MinStatHp}" Grid.Row="2"
                                               Grid.Column="4"
                                               VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.MaxStatHp}" Grid.Row="2"
                                               Grid.Column="5"
                                               VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Center" />

                                    <TextBlock Text="Attaque" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"
                                               FontWeight="Bold" Margin="0,0,4,0" />
                                    <ProgressBar Grid.Row="3" Grid.Column="1" Maximum="200"
                                                 Value="{x:Bind ViewModel.Pokemon.BaseStatAtk}"
                                                 Width="200" Height="40" Margin="4" HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.BaseStatAtk}" Grid.Row="3"
                                               Grid.Column="1"
                                               VerticalAlignment="Center" Margin="10,4,4,4" Foreground="White" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.MinStatAtk}" Grid.Row="3"
                                               Grid.Column="4"
                                               VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.MaxStatAtk}" Grid.Row="3"
                                               Grid.Column="5"
                                               VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Center" />

                                    <TextBlock Text="Défense" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                                               FontWeight="Bold" Margin="0,0,4,0" />
                                    <ProgressBar Grid.Row="4" Grid.Column="1" Maximum="200"
                                                 Value="{x:Bind ViewModel.Pokemon.BaseStatDef}"
                                                 Width="200" Height="40" Margin="4" HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.BaseStatDef}" Grid.Row="4"
                                               Grid.Column="1"
                                               VerticalAlignment="Center" Margin="10,4,4,4" Foreground="White" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.MinStatDef}" Grid.Row="4"
                                               Grid.Column="4"
                                               VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.MaxStatDef}" Grid.Row="4"
                                               Grid.Column="5"
                                               VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Center" />

                                    <TextBlock Text="Attaque Spéciale" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"
                                               FontWeight="Bold" Margin="0,0,4,0" />
                                    <ProgressBar Grid.Row="5" Grid.Column="1" Maximum="200"
                                                 Value="{x:Bind ViewModel.Pokemon.BaseStatAtkSpe}"
                                                 Width="200" Height="40" Margin="4" HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.BaseStatAtkSpe}"
                                               Grid.Row="5" Grid.Column="1"
                                               VerticalAlignment="Center" Margin="10,4,4,4" Foreground="White" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.MinStatAtkSpe}"
                                               Grid.Row="5" Grid.Column="4"
                                               VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.MaxStatAtkSpe}"
                                               Grid.Row="5" Grid.Column="5"
                                               VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Center" />

                                    <TextBlock Text="Défense Spéciale" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"
                                               FontWeight="Bold" Margin="0,0,4,0" />
                                    <ProgressBar Grid.Row="6" Grid.Column="1" Maximum="200"
                                                 Value="{x:Bind ViewModel.Pokemon.BaseStatDefSpe}"
                                                 Width="200" Height="40" Margin="4" HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.BaseStatDefSpe}"
                                               Grid.Row="6" Grid.Column="1"
                                               VerticalAlignment="Center" Margin="10,4,4,4" Foreground="White" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.MinStatDefSpe}"
                                               Grid.Row="6" Grid.Column="4"
                                               VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.MaxStatDefSpe}"
                                               Grid.Row="6" Grid.Column="5"
                                               VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Center" />

                                    <TextBlock Text="Vitesse" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"
                                               FontWeight="Bold" Margin="0,0,4,0" />
                                    <ProgressBar Grid.Row="7" Grid.Column="1" Maximum="200"
                                                 Value="{x:Bind ViewModel.Pokemon.BaseStatSpd}"
                                                 Width="200" Height="40" Margin="4" HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.BaseStatSpd}" Grid.Row="7"
                                               Grid.Column="1"
                                               VerticalAlignment="Center" Margin="10,4,4,4" Foreground="White" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.MinStatSpd}" Grid.Row="7"
                                               Grid.Column="4"
                                               VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.MaxStatSpd}" Grid.Row="7"
                                               Grid.Column="5"
                                               VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Center" />

                                    <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="6" BorderThickness="0,1,0,0" BorderBrush="Bisque"/>

                                    <TextBlock Text="Total" Grid.Row="9" Grid.Column="0" VerticalAlignment="Center"
                                               FontWeight="Bold" Margin="0,0,4,0" />
                                    <ProgressBar Grid.Row="9" Grid.Column="1" Maximum="1200"
                                                 Value="{x:Bind ViewModel.Pokemon.BaseStatsTotal}"
                                                 Width="200" Height="40" Margin="4" HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind ViewModel.Pokemon.BaseStatsTotal}" Grid.Row="9"
                                               Grid.Column="1"
                                               VerticalAlignment="Center" Margin="10,4,4,4" Foreground="White" />
                                </Grid>
                            </StackPanel>
                            <StackPanel x:Name="SectionExperience">
                                <userControls:UserControlTitle Title="Expérience" />

                                <Grid Margin="10,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="Courbe de progression" FontWeight="Bold"
                                               Margin="0,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{x:Bind ViewModel.Pokemon.GrowthRate}"
                                               Margin="16,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="Expérience au niveau 50" FontWeight="Bold"
                                               Margin="0,7,0,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Margin="16,7,0,0" VerticalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.Pokemon.Exp50}" />
                                        <Run Text="points" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="Expérience au niveau 100" FontWeight="Bold"
                                               Margin="0,7,0,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Margin="16,7,0,0" VerticalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.Pokemon.Exp100}" />
                                        <Run Text="points" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <PivotItem Header="Attaques">
                    <ScrollViewer Margin="0,12,-12,0" HorizontalContentAlignment="Left"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel x:Name="SectionMoves">
                                <userControls:UserControlTitle Title="Attaques en 6ème génération" />
                                <ListView x:Name="ListViewMoves"
                                          SelectionMode="None"
                                          ItemsSource="{x:Bind ViewModel.Moves}"
                                          ItemTemplate="{StaticResource MoveItemTemplate}"
                                          Margin="0,0,0,20" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </PivotItem>

                <PivotItem Header="Autres">
                    <ScrollViewer Margin="0,12,-12,0" HorizontalContentAlignment="Left"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <StackPanel x:Name="SectionBreeding">
                                <userControls:UserControlTitle Title="Reproduction" />

                                <TextBlock TextWrapping="Wrap" Margin="10,0,0,10">
                                    <Run Text="Théoriquement, son éclosion nécéssite" />
                                    <Run Text="{x:Bind ViewModel.Pokemon.HatchSteps}"
                                         FontWeight="Bold" />
                                    <Run Text="pas." />
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Margin="10,0,0,10"
                                           Visibility="{Binding IsFromNoEggsGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Run Text="{x:Bind ViewModel.Pokemon.NameFr}" FontWeight="Bold" />
                                    <Run Text="fait partie du groupe" />
                                    <Run Text="{x:Bind ViewModel.EgggroupNames}" FontWeight="Bold" />
                                    <Run Text="et ne peut pas se reproduire." />
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Margin="10,0,0,10"
                                           Visibility="{Binding IsFromNoEggsGroup, ConverterParameter=true, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Run Text="{x:Bind ViewModel.Pokemon.NameFr}" FontWeight="Bold" />
                                    <Run Text="fait partie du groupe" />
                                    <Run Text="{x:Bind ViewModel.EgggroupNames}" FontWeight="Bold" />
                                    <Run Text="et est compatible à la reproduction avec les" />
                                    <Run Text="{x:Bind ViewModel.PokemonsByEgggroup.Count}" FontWeight="Bold" />
                                    <Run Text="pokémons suivants." />
                                </TextBlock>

                                <GridView ItemsSource="{x:Bind ViewModel.PokemonsByEgggroup}"
                                          SelectionMode="None" Margin="0,10,0,20">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="models:PokemonLite">
                                            <StackPanel Tapped="BreedingElement_OnTapped">
                                                <Image
                                                    Source="{x:Bind FormKey, Converter={StaticResource FormKeyToIconPathConverter}}"
                                                    Width="40" Height="30">
                                                    <ToolTipService.ToolTip>
                                                        <TextBlock Text="{x:Bind Name}" />
                                                    </ToolTipService.ToolTip>
                                                </Image>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
            </Pivot>


        </Grid>
    </RelativePanel>
</Page>