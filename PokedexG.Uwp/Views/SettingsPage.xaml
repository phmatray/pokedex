<Page x:Class="PokedexG.Uwp.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Template10.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls1="using:Microsoft.Toolkit.Uwp.UI.Controls"
      xmlns:uwp="using:FontAwesome.UWP"
      xmlns:viewModels="using:PokedexG.Uwp.ViewModels"
      mc:Ignorable="d">

    <Page.DataContext>
        <viewModels:SettingsPageViewModel x:Name="ViewModel" />
    </Page.DataContext>


    <RelativePanel Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveVisualStateGroup">
                <VisualState x:Name="VisualStateNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource NarrowMinWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        
                        <!--  TODO: change properties for narrow view  -->
                        <Setter Target="MainScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                        <Setter Target="MainScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                        <Setter Target="MainGrid.Orientation" Value="Vertical"/>
                        <Setter Target="MainGrid.Margin" Value="0"/>
                        <Setter Target="Grid1.ColumnDefinitions[0].Width" Value="*"/>
                        <Setter Target="Grid2.ColumnDefinitions[0].Width" Value="*"/>
                        <Setter Target="Grid1.Margin" Value="0 0 26 6"/>
                        <Setter Target="Grid2.Margin" Value="0 6 26 26"/>
                        
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VisualStateNormal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource NormalMinWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        
                        <!--  TODO: change properties for normal view  -->
                        <Setter Target="MainScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                        <Setter Target="MainScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                        <Setter Target="MainGrid.Orientation" Value="Horizontal"/>
                        <Setter Target="MainGrid.Margin" Value="0"/>
                        <Setter Target="Grid1.ColumnDefinitions[0].Width" Value="420"/>
                        <Setter Target="Grid2.ColumnDefinitions[0].Width" Value="420"/>
                        <Setter Target="Grid1.Margin" Value="0 0 6 14"/>
                        <Setter Target="Grid2.Margin" Value="60 0 14 14"/>
                        
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VisualStateWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideMinWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        
                        <!--  TODO: change properties for wide view  -->
                        <Setter Target="MainScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                        <Setter Target="MainScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                        <Setter Target="MainGrid.Orientation" Value="Horizontal"/>
                        <Setter Target="MainGrid.Margin" Value="0"/>
                        <Setter Target="Grid1.ColumnDefinitions[0].Width" Value="420"/>
                        <Setter Target="Grid2.ColumnDefinitions[0].Width" Value="420"/>
                        <Setter Target="Grid1.Margin" Value="0 0 6 14"/>
                        <Setter Target="Grid2.Margin" Value="60 0 14 14"/>
                        
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  header  -->
        <controls:PageHeader x:Name="pageHeader" Content="Options"
                             Frame="{x:Bind Frame}"
                             RelativePanel.AlignLeftWithPanel="True"
                             RelativePanel.AlignRightWithPanel="True"
                             RelativePanel.AlignTopWithPanel="True" />

        <!--  content  -->
        <Pivot x:Name="MyPivot"
               RelativePanel.AlignBottomWithPanel="True"
               RelativePanel.AlignLeftWithPanel="True"
               RelativePanel.AlignRightWithPanel="True"
               RelativePanel.Below="pageHeader">

            <!--  settings  -->
            <PivotItem DataContext="{Binding SettingsPartViewModel}" Header="Paramètres">
                <ScrollViewer Margin="0,12,-12,0" HorizontalContentAlignment="Left"
                              VerticalScrollBarVisibility="Auto">
                    <RelativePanel HorizontalAlignment="Left">

                        <controls1:HeaderedTextBlock x:Name="UseShellDrawnBackButtonHeader" 
                                                     Header="Position du bouton de retour"
                                                     RelativePanel.AlignLeftWithPanel="True"
                                                     RelativePanel.AlignTopWithPanel="True" Margin="0,0,0,-20"/>

                        <ToggleSwitch x:Name="UseShellDrawnBackButtonToggleSwtich"
                                      IsOn="{Binding UseShellBackButton, Mode=TwoWay}"
                                      OffContent="Bouton de retour dans l'entête de page"
                                      OnContent="bouton de retour dans la barre de titre ou la barre des tâches"
                                      RelativePanel.Below="UseShellDrawnBackButtonHeader"/>

                        <controls1:HeaderedTextBlock x:Name="UsePokedexEvolutionFamiliesHeader" 
                                                     Header="Style du Pokédex"
                                                     RelativePanel.AlignLeftWithPanel="True" Margin="0,20,0,-20"
                                                     RelativePanel.Below="UseShellDrawnBackButtonToggleSwtich"/>

                        <ToggleSwitch x:Name="UsePokedexEvolutionFamiliesToggleSwtich"
                                      IsOn="{Binding UsePokedexEvolutionFamilies, Mode=TwoWay}"
                                      OffContent="Pokédex trié par numéro"
                                      OnContent="Pokédex trié par famille d'évolution"
                                      RelativePanel.Below="UsePokedexEvolutionFamiliesHeader"/>

                        <ToggleSwitch x:Name="UsePokedexMegaEvolutionsToggleSwtich"
                                      IsOn="{Binding UsePokedexMegaEvolutions, Mode=TwoWay}"
                                      OffContent="Masquer les méga-évolutions"
                                      OnContent="Afficher les méga-évolutions"
                                      RelativePanel.Below="UsePokedexEvolutionFamiliesToggleSwtich"/>

                        <ToggleSwitch x:Name="UsePokedexAlternativesToggleSwtich"
                                      IsOn="{Binding UsePokedexAlternatives, Mode=TwoWay}"
                                      OffContent="Masquer les formes alternatives"
                                      OnContent="Afficher les formes alternatives"
                                      RelativePanel.Below="UsePokedexMegaEvolutionsToggleSwtich"/>

                        <controls1:HeaderedTextBlock x:Name="ArtworkStyleHeader" 
                                                     Header="Style des illustrations"
                                                     RelativePanel.AlignLeftWithPanel="True" Margin="0,20,0,-20"
                                                     RelativePanel.Below="UsePokedexAlternativesToggleSwtich"/>

                        <ToggleSwitch x:Name="ArtworkStyleToggleSwtich"
                                      IsOn="{Binding ArtworkStyle, Mode=TwoWay}"
                                      OffContent="Illustrations du Global Link"
                                      OnContent="Illustrations de Sugimori"
                                      RelativePanel.Below="ArtworkStyleHeader"/>

                        <!--<controls1:HeaderedTextBlock x:Name="ClearCacheHeader"
                                                     Header="Cache"
                                                     RelativePanel.Below="ArtworkStyleToggleSwtich" Margin="0,20,0,-20"/>

                        <Button Margin="12,0,0,0"
                                Command="{x:Bind ViewModel.SettingsPartViewModel.ClearCacheCommand}"
                                Content="Vider le cache"
                                RelativePanel.Below="ClearCacheHeader" />-->

                        <!--<ToggleSwitch x:Name="UseLightThemeToggleSwitch" Header="Use Light Theme"
                                      IsOn="{Binding UseLightThemeButton, Mode=TwoWay}"
                                      OffContent="Dark theme" OnContent="Light theme"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.Below="UseShellDrawnBackButtonToggleSwtich" />-->

                        <!--<TextBox x:Name="BusyTextTextBox" Width="200"
                                 Margin="0,12,0,0" HorizontalAlignment="Left"
                                 Header="Busy text" RelativePanel.AlignLeftWithPanel="True"
                                 RelativePanel.Below="UseLightThemeToggleSwitch"
                                 Text="{Binding BusyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />-->

                        <!--<Button Margin="12,0,0,0"
                                Command="{x:Bind ViewModel.SettingsPartViewModel.ShowBusyCommand}"
                                Content="Show Busy"
                                RelativePanel.AlignBottomWith="BusyTextTextBox"
                                RelativePanel.RightOf="BusyTextTextBox" />-->

                    </RelativePanel>

                </ScrollViewer>
            </PivotItem>

            <!--  privacy  -->
