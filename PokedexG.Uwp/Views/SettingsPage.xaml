            <!--  about  -->
            <PivotItem Header="Infos">
                <ScrollViewer x:Name="MainScrollViewer"
                              Margin="0,12,-12,0" HorizontalContentAlignment="Left"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MainGrid">
                        
                        <Grid x:Name="Grid1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel DataContext="{Binding AboutPartViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <Border HorizontalAlignment="Left"
                                            VerticalAlignment="Top" BorderBrush="DimGray"
                                            BorderThickness="1" IsHitTestVisible="False" Width="80" Height="80">
                                        <Border.Background>
                                            <SolidColorBrush Color="{ThemeResource SystemAccentColor}" />
                                        </Border.Background>
                                        <Image Margin="12" Source="{Binding Logo}" Stretch="None" />
                                    </Border>

                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Top" >
                                        <TextBlock  Margin="0,0,0,0" FontSize="24" Text="{Binding DisplayName}" FontWeight="Bold"/>
                                        <TextBlock  Margin="0,0,0,12" FontSize="20">
                                            <Run Text="version"/>
                                            <Run Text="{Binding Version}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Pokédex G est le pokédex 6G le plus complet et le plus pratique sur Windows 10. Découvrez les fiches des 721 Pokémons existants, leurs méga-évolutions et leurs formes alternatives." TextWrapping="Wrap" TextAlignment="Justify" Margin="0,20,0,0"/>

                                <controls1:HeaderedTextBlock Header="Soutenir Pokédex G" Margin="0,20,0,-20"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Évaluer Pokédex G" Width="200" Click="ReviewApp_OnClick"/>
                                    <Button Content="Partager sur Facebook" Width="200" Margin="10,0,0,0" 
                                            Command="{x:Bind ViewModel.AboutPartViewModel.ShareOnFacebookCommand}"/>
                                    <!--<Button Content="Faire un don" Margin="10,0,0,0" Width="150"/>-->
                                </StackPanel>
                                

                                <controls1:HeaderedTextBlock Header="Créé par" Margin="0,20,0,-20"/>
                                <Border BorderThickness="2" BorderBrush="{ThemeResource SystemControlForegroundAccentBrush}" Width="184" Height="184" HorizontalAlignment="Left" Margin="0,0,0,20">
                                    <Grid>
                                        <Image Source="ms-appx:///Assets/interface/me.jpg" Stretch="UniformToFill"/>
                                        <Border Height="32" Background="#7F000000" VerticalAlignment="Bottom">
                                            <TextBlock Text="Philippe MATRAY" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FFCCCCCC" FontSize="15" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                        
                        <Grid x:Name="Grid2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <controls1:HeaderedTextBlock Header="Crédits" Margin="0,0,0,-20"/>
                                <TextBlock Text="Un grand merci pour la base de données :" FontWeight="Bold"/>
                                <HyperlinkButton NavigateUri="http://veekun.com/" Content="Veekun"/>
                                <TextBlock Text="Site web de Pokémon :" Margin="0,10,0,0" FontWeight="Bold"/>
                                <HyperlinkButton NavigateUri="http://www.pokemon.com/" Content="pokemon.com" Margin="0,0,0,5"/>

                                <controls1:HeaderedTextBlock Header="Contact" Margin="0,20,0,-20"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <HyperlinkButton Grid.Column="0" NavigateUri="https://twitter.com/phmatray" HorizontalAlignment="Center">
                                        <StackPanel Margin="5">
                                            <uwp:FontAwesome Icon="Twitter" FontSize="72" HorizontalAlignment="Center" Foreground="#FF33CCFF" />
                                            <TextBlock Text="@phmatray" HorizontalAlignment="Center" Foreground="#FF33CCFF" FontWeight="Bold"/>
                                        </StackPanel>
                                    </HyperlinkButton>

                                    <HyperlinkButton Grid.Column="1" NavigateUri="mailto://phmatray@outlook.com" HorizontalAlignment="Center">
                                        <StackPanel Margin="5">
                                            <uwp:FontAwesome Icon="Envelope" FontSize="72" HorizontalAlignment="Center" Foreground="#FF3636A6" />
                                            <TextBlock Text="e-mail" HorizontalAlignment="Center" Foreground="#FF3636A6" FontWeight="Bold"/>
                                        </StackPanel>
                                    </HyperlinkButton>

                                    <HyperlinkButton Grid.Column="2" NavigateUri="http://phmatray.net" HorizontalAlignment="Center">
                                        <StackPanel Margin="5">
                                            <uwp:FontAwesome Icon="Home" FontSize="72" HorizontalAlignment="Center" Foreground="#FFFF9933" />
                                            <TextBlock Text="site perso" HorizontalAlignment="Center" Foreground="#FFFF9933" FontWeight="Bold"/>
                                        </StackPanel>
                                    </HyperlinkButton>
                                </Grid>

                                <controls1:HeaderedTextBlock Header="Trademaks" Margin="0,20,0,-20"/>
                                <TextBlock Text="Pokédex G n'est pas affilié avec, sponsorisé, ou spécifiquement approuvé par Nintendo, Game Freak, Creatures et The Pokémon Company. Pokémon est une marque déposée de Nintendo Co., Ltd." TextWrapping="Wrap" TextAlignment="Justify"/>
                            </StackPanel>
                        </Grid>
                        
                    </StackPanel>
                </ScrollViewer>
                
            </PivotItem>
        </Pivot>

    </RelativePanel>

</Page>

