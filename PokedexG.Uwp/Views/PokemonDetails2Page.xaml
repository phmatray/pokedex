<Page x:Class="PokedexG.Uwp.Views.PokemonDetails2Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Template10.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls1="using:Microsoft.Toolkit.Uwp.UI.Controls"
      xmlns:viewModels="using:PokedexG.Uwp.ViewModels"
      xmlns:userControls="using:PokedexG.Uwp.Views.UserControls"
      mc:Ignorable="d">

    <Page.DataContext>
        <viewModels:PokemonDetailsPageViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Page.Resources>
        <DataTemplate x:Name="MoveItemTemplate" x:DataType="models:Move">
            <Grid BorderBrush="Bisque" BorderThickness="1" CornerRadius="5" Margin="0,10,20,10" Padding="10">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="150px"/>
                    <ColumnDefinition Width="380px"/>
                    <ColumnDefinition Width="50px"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                           Text="{x:Bind Level}" Width="50px" VerticalAlignment="Center" FontWeight="Bold" FontSize="18"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" FontWeight="Bold"/>
                    <TextBlock Text="{x:Bind NameEn, Converter={StaticResource StringFormatConverter}, ConverterParameter='(\{0\})'}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                    <userControls:UserControlType TypeId="{x:Bind TypeId}" Text="{x:Bind Type}"/>
                    <userControls:UserControlDamage DamageClassIdentifier="{x:Bind DamageClass}" Margin="4,0,0,0"/>
                    <!--<TextBlock Text="{x:Bind Ailment}" Margin="4,0,0,0"/>-->
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold"
                           Text="{x:Bind Pp, Converter={StaticResource NullStringToPlaceholderConverter}, ConverterParameter='\{0\} PP'}"/>
                    <TextBlock FontWeight="Bold"
                           Text="{x:Bind Power, Converter={StaticResource NullStringToPlaceholderConverter}}"/>
                    <TextBlock FontWeight="Bold"
                           Text="{x:Bind Accuracy, Converter={StaticResource NullStringToPlaceholderConverter}, ConverterParameter='\{0\}%'}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" TextWrapping="Wrap"
                           Text="{x:Bind FlavorText}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <RelativePanel Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveVisualStateGroup">
                <VisualState x:Name="VisualStateNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource NarrowMinWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        
                        <!--  TODO: change properties for narrow view  -->
                        <Setter Target="MainScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                        <Setter Target="MainScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                        <Setter Target="MainGrid.Orientation" Value="Vertical"/>
                        <Setter Target="MainGrid.Margin" Value="12"/>
                        <Setter Target="Grid1.ColumnDefinitions[0].Width" Value="*"/>
                        <Setter Target="Grid2.ColumnDefinitions[0].Width" Value="*"/>
                        <Setter Target="Grid3.ColumnDefinitions[0].Width" Value="*"/>
                        <Setter Target="Grid4.ColumnDefinitions[0].Width" Value="*"/>
                        <Setter Target="Grid1.Margin" Value="0 0 14 6"/>
                        <Setter Target="Grid2.Margin" Value="0 6 14 6"/>
                        <Setter Target="Grid3.Margin" Value="0 6 14 6"/>
                        <Setter Target="Grid4.Margin" Value="0 6 14 6"/>
                        <Setter Target="Grid5.Margin" Value="0 6 14 14"/>
                        <Setter Target="ListViewMoves.Height" Value="Auto"/>

                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VisualStateNormal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource NormalMinWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        
                        <!--  TODO: change properties for normal view  -->
                        <Setter Target="MainScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                        <Setter Target="MainScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                        <Setter Target="MainGrid.Orientation" Value="Horizontal"/>
                        <Setter Target="MainGrid.Margin" Value="12"/>
                        <Setter Target="Grid1.ColumnDefinitions[0].Width" Value="300"/>
                        <Setter Target="Grid2.ColumnDefinitions[0].Width" Value="460"/>
                        <Setter Target="Grid1.Margin" Value="0 0 6 14"/>
                        <Setter Target="Grid2.Margin" Value="60 0 6 14"/>
                        <Setter Target="Grid3.Margin" Value="40 0 6 14"/>
                        <Setter Target="Grid4.Margin" Value="60 0 6 14"/>
                        <Setter Target="Grid5.Margin" Value="60 0 14 14"/>
                        <Setter Target="ListViewMoves.Height" Value="650"/>

                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VisualStateWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideMinWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        
                        <!--  TODO: change properties for wide view  -->
                        <Setter Target="MainScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                        <Setter Target="MainScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                        <Setter Target="MainGrid.Orientation" Value="Horizontal"/>
                        <Setter Target="MainGrid.Margin" Value="12"/>
                        <Setter Target="Grid1.ColumnDefinitions[0].Width" Value="300"/>
                        <Setter Target="Grid2.ColumnDefinitions[0].Width" Value="460"/>
                        <Setter Target="Grid1.Margin" Value="0 0 6 14"/>
                        <Setter Target="Grid2.Margin" Value="60 0 6 14"/>
                        <Setter Target="Grid3.Margin" Value="40 0 6 14"/>
                        <Setter Target="Grid4.Margin" Value="60 0 6 14"/>
                        <Setter Target="Grid5.Margin" Value="60 0 14 14"/>
                        <Setter Target="ListViewMoves.Height" Value="650"/>

                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  header  -->
        <controls:PageHeader x:Name="pageHeader" Frame="{x:Bind Frame}"
                             RelativePanel.AlignLeftWithPanel="True"
                             RelativePanel.AlignRightWithPanel="True"
                             RelativePanel.AlignTopWithPanel="True"
                             Text="Détails d'un Pokémon"/>

        <Grid x:Name="DetailsHeader"  Height="48" VerticalAlignment="Top"
              Background="{ThemeResource ButtonBackgroundThemeBrush}"
              RelativePanel.AlignLeftWithPanel="True"
              RelativePanel.AlignRightWithPanel="True"
              RelativePanel.Below="pageHeader">
            <StackPanel Orientation="Horizontal">
                <Border VerticalAlignment="Stretch" Width="48">
                    <Image Source="{x:Bind ViewModel.CurrentPokemonDetails.FormKey, Converter={StaticResource FormKeyToIconPathConverter}}"
                           Width="40" Height="30" />
                </Border>
                <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.PokedexNumberNationalFormatedWithSuffix, FallbackValue=#001}"
                            Style="{StaticResource TitleTextBlockStyle}"
                            VerticalAlignment="Center" Margin="10,4,10,0" FontFamily="Segoe UI Semibold" FontSize="18" />
                <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.NameFr, FallbackValue=PokemonNameFr, Mode=OneWay}" 
                            Style="{StaticResource TitleTextBlockStyle}"
                            VerticalAlignment="Center" FontWeight="Bold" FontFamily="Segoe UI Semibold" FontSize="18" Margin="10,4,0,0"/>
                <TextBlock Text="(fr)" FontSize="14" FontFamily="Segoe UI Semibold" VerticalAlignment="Top" Margin="2,10,0,0"/>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.CurrentPokemonDetails.NameEn, FallbackValue=PokemonNameEn, Mode=OneWay}" 
                            Margin="20,4,0,0" VerticalAlignment="Center"  FontFamily="Segoe UI Semibold" FontSize="18"/>
                <TextBlock Text="(en)" FontSize="14" FontFamily="Segoe UI Semibold" VerticalAlignment="Top" Margin="2,10,0,0"/>
                <!--<TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.CurrentPokemon.NameJp, Mode=OneWay, FallbackValue=DesigntimeValue}" Margin="20,0,0,0" VerticalAlignment="Bottom"  />
                <TextBlock Text="(jp)"/>-->
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="MainScrollViewer"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.AlignBottomWithPanel="True"
                      RelativePanel.Below="DetailsHeader">
            
            <StackPanel x:Name="MainGrid">
                
                <Grid x:Name="Grid1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Margin="0,0,0,20">
                        <!-- Informations -->
                        <userControls:UserControlTitle Title="Informations"/>

                        <controls1:ImageEx Source="{x:Bind ViewModel.CurrentPokemonDetails.FormKey, Converter={StaticResource SpecieIdToIllustrationPathConverter}}"
                                   MaxWidth="300" MaxHeight="300" HorizontalAlignment="Left" Margin="0,20,0,0"/>

                        <Grid HorizontalAlignment="Left" Margin="0,20,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Type(s)" Grid.Row="0" Grid.Column="0" FontWeight="Bold" Margin="0,7,0,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" Margin="16,7,0,0" HorizontalAlignment="Left">
                                <userControls:UserControlType TypeId="{x:Bind ViewModel.CurrentPokemonDetails.Type1Id}" 
                                                                  Text="{x:Bind ViewModel.CurrentPokemonDetails.Type1Name}" Tapped="Type1_OnTapped"/>
                                <userControls:UserControlType TypeId="{x:Bind ViewModel.CurrentPokemonDetails.Type2Id}" 
                                                                  Text="{x:Bind ViewModel.CurrentPokemonDetails.Type2Name}" Tapped="Type2_OnTapped" Margin="0,4,0,0"
                                                                  Visibility="{x:Bind ViewModel.CurrentPokemonDetails.Type2Id, Converter={StaticResource NullToVisibilityConverter}}">
                                </userControls:UserControlType>
                            </StackPanel>
                            <TextBlock Text="Taux de capture" Grid.Row="1" Grid.Column="0" FontWeight="Bold" Margin="0,7,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.CaptureRate}" Grid.Row="1" Grid.Column="1" Margin="16,7,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ratio sexe" Grid.Row="2" Grid.Column="0" FontWeight="Bold" Margin="0,7,0,0" VerticalAlignment="Center"/>
                            <userControls:UserControlGender Grid.Row="2" Grid.Column="1" Margin="16,7,0,0" VerticalAlignment="Stretch"
                                             GenderCode="{x:Bind ViewModel.CurrentPokemonDetails.GenderRate}" HorizontalAlignment="Left"/>
                            <TextBlock Text="Couleur" Grid.Row="3" Grid.Column="0" FontWeight="Bold" Margin="0,7,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.ColorName}" Grid.Row="3" Grid.Column="1" Margin="16,7,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Mensurations" Grid.Row="4" Grid.Column="0" FontWeight="Bold" Margin="0,7,0,0" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1">
                                <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.Height, Converter={StaticResource HeightToFormatConverter}}" Margin="16,7,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="/" Margin="4,7,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.Weight, Converter={StaticResource WeightToFormatConverter}}" Margin="0,7,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Forme" Grid.Row="5" Grid.Column="0" FontWeight="Bold" Margin="0,7,0,0" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="1">
                                <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.Genus, Converter={StaticResource HeightToFormatConverter}}" Margin="16,7,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="/" Margin="4,7,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.ShapeName, Converter={StaticResource WeightToFormatConverter}}" Margin="0,7,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Génération" Grid.Row="6" Grid.Column="0" FontWeight="Bold" Margin="0,7,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.GenerationName}" Grid.Row="6" Grid.Column="1" Margin="16,7,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Progression" Grid.Row="7" Grid.Column="0" FontWeight="Bold" Margin="0,7,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.GrowthRateName}" Grid.Row="7" Grid.Column="1" Margin="16,7,0,0" VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>

                </Grid>
                <Grid x:Name="Grid2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel>
                         <!-- Talents -->
                        <userControls:UserControlTitle Title="Talents"/>
                        
                        <ListView ItemsSource="{x:Bind ViewModel.Abilities}" Margin="0,0,0,20" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:PokemonAbility">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock TextWrapping="Wrap">
                                                <Run Text="{x:Bind AbilityName}" FontWeight="Bold"/>
                                                <Run Text="{x:Bind IsHidden, Converter={StaticResource IsHiddenToTextConverter}}"/>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Text="{x:Bind FlavorText, Converter={StaticResource StringToRemoveBreakConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Breeding -->
                        <userControls:UserControlTitle Title="Reproduction"/>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            <Run Text="Théoriquement, son éclosion nécéssite"/>
                            <Run Text="{x:Bind ViewModel.CurrentPokemonDetails.HatchSteps}" FontWeight="Bold"/>
                            <Run Text="pas."/>
                        </TextBlock>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" 
                                    Visibility="{Binding IsFromNoEggsGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="{x:Bind ViewModel.CurrentPokemonDetails.NameFr}" FontWeight="Bold"/>
                            <Run Text="fait partie du groupe"/>
                            <Run Text="{x:Bind ViewModel.EgggroupNames}" FontWeight="Bold"/>
                            <Run Text="et ne peut pas se reproduire."/>
                        </TextBlock>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                    Visibility="{Binding IsFromNoEggsGroup, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=true}">
                            <Run Text="{x:Bind ViewModel.CurrentPokemonDetails.NameFr}" FontWeight="Bold"/>
                            <Run Text="fait partie du groupe"/>
                            <Run Text="{x:Bind ViewModel.EgggroupNames}" FontWeight="Bold"/>
                            <Run Text="et est compatible à la reproduction avec les"/>
                            <Run Text="{x:Bind ViewModel.PokemonsByEgggroup.Count}" FontWeight="Bold"/>
                            <Run Text="pokémons suivants."/>
                        </TextBlock>

                        <ScrollViewer MaxHeight="200" Margin="0,10,0,20">
                            <GridView ItemsSource="{x:Bind ViewModel.PokemonsByEgggroup}"
                                      MaxWidth="450" HorizontalAlignment="Left">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PokemonLite">
                                        <StackPanel Tapped="BreedingElement_OnTapped">
                                            <Image Source="{x:Bind FormKey, Converter={StaticResource FormKeyToIconPathConverter}}"
                                                    Width="40" Height="30">
                                                <ToolTipService.ToolTip>
                                                    <TextBlock Text="{x:Bind Name}"/>
                                                </ToolTipService.ToolTip>
                                            </Image>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </ScrollViewer>

                        <!-- Weaknesses -->
                        <userControls:UserControlTitle Title="Faiblesses"/>

                        <GridView ItemsSource="{x:Bind ViewModel.Weaknesses}" SelectionMode="None" HorizontalAlignment="Left" MaxWidth="520">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:DamageType">
                                    <StackPanel Orientation="Horizontal">
                                        <userControls:UserControlWeakness Damage="{x:Bind}" Margin="5" Tapped="WeaknessType_OnTapped"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                    
                </Grid>
                <Grid x:Name="Grid3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,0,20">
                        <!-- Description -->
                        <userControls:UserControlTitle Title="Description"/>

                        <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                            <TextBlock Text="Rubis Omega : " FontWeight="Bold" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.FlavorTextOmegaRuby}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                            <TextBlock Text="Saphir Alpha : " FontWeight="Bold" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.FlavorTextAlphaSapphire}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                            <TextBlock Text="X : " FontWeight="Bold" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.FlavorTextX}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,0,20">
                            <TextBlock Text="Y : " FontWeight="Bold" Width="120"  HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.FlavorTextY}" TextWrapping="Wrap"/>
                        </StackPanel>


                        <!-- Evolution -->
                        <userControls:UserControlTitle Title="Evolutions"/>
                        
                        <GridView ItemsSource="{x:Bind ViewModel.Family.EvolutionStades}" SelectionMode="None"> 
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:PokemonFamilyStade">
                                    <StackPanel Width="150" Tapped="Evolution_OnTapped">
                                        <TextBlock Text="{x:Bind Name, FallbackValue='Stade 1'}" FontWeight="Bold"/>
                                        <ListView ItemsSource="{x:Bind Evolutions}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:PokemonEvolution">
                                                    <StackPanel>
                                                        <Grid Height="150">
                                                            <Image Source="{x:Bind PokemonId, Converter={StaticResource SpecieIdToSpritePathConverter}, Mode=OneTime}"
                                                                   Stretch="None" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind NameFr}" VerticalAlignment="Center" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                    </StackPanel>

                </Grid>
                <Grid x:Name="Grid4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,0,20">
                        <!-- Statistique -->
                        <userControls:UserControlTitle Title="Statistiques"/>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                <Run Text="Expérience au niveau"/>
                                <Run Text="50" FontWeight="Bold"/>
                                <Run Text=":"/>
                                <Run Text="{x:Bind ViewModel.CurrentPokemonDetails.Exp50}" FontWeight="Bold"/>
                                <Run Text="xp"/>
                        </TextBlock>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                <Run Text="Expérience au niveau"/>
                                <Run Text="100" FontWeight="Bold"/>
                                <Run Text=":"/>
                                <Run Text="{x:Bind ViewModel.CurrentPokemonDetails.Exp100}" FontWeight="Bold"/>
                                <Run Text="xp"/>
                        </TextBlock>

                        <Grid HorizontalAlignment="Left" Height="209">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="P.V." Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                            <ProgressBar Grid.Row="0" Grid.Column="1" Maximum="200" Value="{x:Bind ViewModel.CurrentPokemonDetails.BaseStatHp}"
                                         Width="200" Height="40" Margin="4" HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.BaseStatHp}" Grid.Row="0" Grid.Column="1"
                                       VerticalAlignment="Center" Margin="10,4,4,4" Foreground="White"/>
                            <TextBlock Text="Max." Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.MaxStatHp}" Grid.Row="0" Grid.Column="3" 
                                       VerticalAlignment="Center" Margin="4,0,0,0" FontWeight="Bold"/>

                            <TextBlock Text="Attaque" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" />
                            <ProgressBar Grid.Row="1" Grid.Column="1" Maximum="200" Value="{x:Bind ViewModel.CurrentPokemonDetails.BaseStatAtk}"
                                         Width="200" Height="40" Margin="4" HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.BaseStatAtk}" Grid.Row="1" Grid.Column="1"
                                       VerticalAlignment="Center" Margin="10,4,4,4" Foreground="White"/>
                            <TextBlock Text="Max." Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.MaxStatAtk}" Grid.Row="1" Grid.Column="3"
                                       VerticalAlignment="Center" Margin="4,0,0,0" FontWeight="Bold"/>

                            <TextBlock Text="Défense" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" />
                            <ProgressBar Grid.Row="2" Grid.Column="1" Maximum="200" Value="{x:Bind ViewModel.CurrentPokemonDetails.BaseStatDef}"
                                         Width="200" Height="40" Margin="4" HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.BaseStatDef}" Grid.Row="2" Grid.Column="1"
                                       VerticalAlignment="Center" Margin="10,4,4,4" Foreground="White"/>
                            <TextBlock Text="Max." Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.MaxStatDef}" Grid.Row="2" Grid.Column="3"
                                       VerticalAlignment="Center" Margin="4,0,0,0" FontWeight="Bold"/>

                            <TextBlock Text="Att. Spé." Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" />
                            <ProgressBar Grid.Row="3" Grid.Column="1" Maximum="200" Value="{x:Bind ViewModel.CurrentPokemonDetails.BaseStatAtkSpe}"
                                         Width="200" Height="40" Margin="4" HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.BaseStatAtkSpe}" Grid.Row="3" Grid.Column="1"
                                       VerticalAlignment="Center" Margin="10,4,4,4" Foreground="White"/>
                            <TextBlock Text="Max." Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.MaxStatAtkSpe}" Grid.Row="3" Grid.Column="3"
                                       VerticalAlignment="Center" Margin="4,0,0,0" FontWeight="Bold"/>

                            <TextBlock Text="Déf. Spé." Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" />
                            <ProgressBar Grid.Row="4" Grid.Column="1" Maximum="200" Value="{x:Bind ViewModel.CurrentPokemonDetails.BaseStatDefSpe}"
                                         Width="200" Height="40" Margin="4" HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.BaseStatDefSpe}" Grid.Row="4" Grid.Column="1"
                                       VerticalAlignment="Center" Margin="10,4,4,4" Foreground="White"/>
                            <TextBlock Text="Max." Grid.Row="4" Grid.Column="2" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.MaxStatDefSpe}" Grid.Row="4" Grid.Column="3"
                                       VerticalAlignment="Center" Margin="4,0,0,0" FontWeight="Bold"/>

                            <TextBlock Text="Vitesse" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" />
                            <ProgressBar Grid.Row="5" Grid.Column="1" Maximum="200" Value="{x:Bind ViewModel.CurrentPokemonDetails.BaseStatSpd}"
                                         Width="200" Height="40" Margin="4" HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.BaseStatSpd}" Grid.Row="5" Grid.Column="1"
                                       VerticalAlignment="Center" Margin="10,4,4,4" Foreground="White"/>
                            <TextBlock Text="Max." Grid.Row="5" Grid.Column="2" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPokemonDetails.MaxStatSpd}" Grid.Row="5" Grid.Column="3"
                                       VerticalAlignment="Center" Margin="4,0,0,0" FontWeight="Bold"/>
                        </Grid>

                    </StackPanel>
                </Grid>
                <Grid x:Name="Grid5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Liste des attaques -->
                    <userControls:UserControlTitle Title="Attaques en 6ème génération" Grid.Row="0"/>
                    <ListView x:Name="ListViewMoves"
                              SelectionMode="None"
                              ItemsSource="{x:Bind ViewModel.Moves}" ItemTemplate="{StaticResource MoveItemTemplate}"
                              Grid.Row="1" Margin="0,0,0,20" />
                </Grid>
                
            </StackPanel>
        </ScrollViewer>
        
        
        

