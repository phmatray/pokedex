<UserControl
    x:Class="PokedexG.Uwp.Views.UserControls.UserControlEvolution"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400"
    d:DataContext="{Binding}">

    <!-- Evolution -->
    <GridView ItemsSource="{x:Bind PokemonFamily.EvolutionStades}" Width="{x:Bind Width}" Height="{x:Bind Height}">
        <GridView.ItemTemplate>
            <DataTemplate x:DataType="models:PokemonFamilyStade">
                <StackPanel Width="150">
                    <TextBlock Text="{x:Bind Name, FallbackValue='Stade 1'}" FontWeight="Bold"/>
                    <ListView ItemsSource="{x:Bind Evolutions}" Height="200">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PokemonEvolution">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{x:Bind PokemonId, Converter={StaticResource FormKeyToIconPathConverter}}"
                                                                   Width="40" Height="30"/>
                                    <TextBlock Text="{x:Bind NameFr}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
    
</UserControl>
