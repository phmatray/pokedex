<UserControl
    x:Class="PokedexG.Uwp.Views.UserControls.UserControlTitle"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400"
    d:DataContext="{Binding}">

    <!-- Informations -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Image Source="ms-appx:///Assets/interface/pokeball.png" Width="24px" Height="24px" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding Title, FallbackValue=Title}" Margin="10" FontWeight="Bold" FontSize="24"/>
    </StackPanel>
    
</UserControl>
