<UserControl
    x:Class="PokedexG.Uwp.Views.UserControls.UserControlWeakness"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400"
    Width="130"
    Height="34"
    d:DataContext="{Binding}">

    <Grid Background="White">
        <Border CornerRadius="14" Background="{Binding Background, FallbackValue=#FF0FFF0F}" Margin="0,2,14,2">
            <TextBlock Text="{Binding DamageTypeName, FallbackValue=MyType}"
                       VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"
                       FontFamily="Segoe UI Semibold" FontSize="{Binding FontSize, FallbackValue=14}" />
        </Border>
        <Border BorderBrush="White" BorderThickness="3" CornerRadius="16" 
                Background="{Binding DamageFactorBackground, FallbackValue=Black}" 
                Margin="0,0,-3,0" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding DamageFactor, FallbackValue=x4}" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{Binding DamageFactorForeground, FallbackValue=White}" FontWeight="Bold" Margin="0,-3,0,0"/>
        </Border>
    </Grid>

</UserControl>