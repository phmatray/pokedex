<UserControl
    x:Class="PokedexG.Uwp.Views.UserControls.UserControlGender"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400"
    Width="100"
    Height="24"
    d:DataContext="{Binding}">

    <Grid Width="{Binding Width}" Height="{Binding Height}"
          BorderBrush="#FF5D5D5D" BorderThickness="1">

        <ProgressBar VerticalAlignment="Stretch" Maximum="8" SmallChange="1"
                     Background="{Binding BackgroundBrush, FallbackValue=#FF2FA0FF}"
                     Value="{Binding GenderCode, FallbackValue=4}"
                     Foreground="#FFFF9CF6" />
    </Grid>
</UserControl>