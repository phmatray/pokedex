<Page x:Class="PokedexG.Uwp.Views.MachinesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controlsT10="using:Template10.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
      xmlns:viewModels="using:PokedexG.Uwp.ViewModels"
      xmlns:userControls="using:PokedexG.Uwp.Views.UserControls"
      xmlns:models="using:PokedexG.Uwp.Models"
      mc:Ignorable="d">

    <Page.DataContext>
        <viewModels:MachinesPageViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Page.Resources>
        <DataTemplate x:Name="MachineTemplate" x:DataType="models:Machine">
            <Grid Margin="10" BorderBrush="Bisque" BorderThickness="1" CornerRadius="5">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="40px"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340px"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="{x:Bind ItemName}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind Name}" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <TextBlock Text="{x:Bind NameEn, ConverterParameter=(\{0\}), Converter={StaticResource StringFormatConverter}}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                        <userControls:UserControlType TypeId="{x:Bind TypeId}" Text="{x:Bind Type}"/>
                        <userControls:UserControlDamage DamageClassIdentifier="{x:Bind DamageClass}" Margin="4,0,0,0"/>
                        <!--<TextBlock Text="{x:Bind Ailment}" Margin="4,0,0,0"/>-->
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Center">
                        <TextBlock FontWeight="Bold"
                            Text="{x:Bind Pp, ConverterParameter=\{0\} PP, Converter={StaticResource NullStringToPlaceholderConverter}}"/>
                        <TextBlock FontWeight="Bold"
                            Text="{x:Bind Power, Converter={StaticResource NullStringToPlaceholderConverter}}"/>
                        <TextBlock FontWeight="Bold"
                            Text="{x:Bind Accuracy, ConverterParameter=\{0\}%, Converter={StaticResource NullStringToPlaceholderConverter}}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" TextWrapping="Wrap"
                        Text="{x:Bind FlavorText}"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <RelativePanel Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveVisualStateGroup">
                <VisualState x:Name="VisualStateNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource NarrowMinWidth}" />
                    </VisualState.StateTriggers>
                    <!--<VisualState.Setters>
                          TODO: change properties for narrow view  
                        <Setter Target="stateTextBox.Text" Value="Narrow Visual State" />
                    </VisualState.Setters>-->
                </VisualState>
                <VisualState x:Name="VisualStateNormal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource NormalMinWidth}" />
                    </VisualState.StateTriggers>
                    <!--<VisualState.Setters>
                          TODO: change properties for normal view  
                        <Setter Target="stateTextBox.Text" Value="Normal Visual State" />
                    </VisualState.Setters>-->
                </VisualState>
                <VisualState x:Name="VisualStateWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideMinWidth}" />
                    </VisualState.StateTriggers>
                    <!--<VisualState.Setters>
                          TODO: change properties for wide view  
                        <Setter Target="stateTextBox.Text" Value="Wide Visual State" />
                    </VisualState.Setters>-->
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <controlsT10:PageHeader x:Name="pageHeader" RelativePanel.AlignLeftWithPanel="True"
                             RelativePanel.AlignRightWithPanel="True"
                             RelativePanel.AlignTopWithPanel="True"
                             Text="Capsules techniques">

            <!--  secondary commands  -->
            <!--<controlsT10:PageHeader.SecondaryCommands>
                <AppBarButton Click="{x:Bind ViewModel.GotoSettings}" Label="Settings" />
                <AppBarButton Click="{x:Bind ViewModel.GotoPrivacy}" Label="Privacy" />
                <AppBarButton Click="{x:Bind ViewModel.GotoAbout}" Label="About" />
            </controlsT10:PageHeader.SecondaryCommands>-->

        </controlsT10:PageHeader>

        <controls:AdaptiveGridView ItemsSource="{x:Bind ViewModel.Machines, Mode=OneWay}"
                                   ItemHeight="200"
                                   DesiredWidth="400"
                                   ItemTemplate="{StaticResource MachineTemplate}"
                                   RelativePanel.AlignLeftWithPanel="True"
                                   RelativePanel.AlignRightWithPanel="True"
                                   RelativePanel.AlignBottomWithPanel="True"
                                   RelativePanel.Below="pageHeader" Margin="5,5,0,0"/>
    </RelativePanel>
</Page>



