<Page x:Class="PokedexG.Uwp.Views.PokemonsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Template10.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls1="using:Microsoft.Toolkit.Uwp.UI.Controls"
      xmlns:viewModels="using:PokedexG.Uwp.ViewModels"
      xmlns:userControls="using:PokedexG.Uwp.Views.UserControls"
      xmlns:models="using:PokedexG.Uwp.Models"
      mc:Ignorable="d">

    <Page.DataContext>
        <viewModels:PokemonsPageViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarToggleButton >
                <AppBarToggleButton.Icon>
                    <SymbolIcon/>
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
        </CommandBar>
    </Page.BottomAppBar>
    
    <Page.Resources>
    </Page.Resources>

    <RelativePanel Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveVisualStateGroup">
                <VisualState x:Name="VisualStateNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource NarrowMinWidth}" />
                    </VisualState.StateTriggers>
                    <!--<VisualState.Setters>
                          TODO: change properties for narrow view  
                        <Setter Target="stateTextBox.Text" Value="Narrow Visual State" />
                    </VisualState.Setters>-->
                </VisualState>
                <VisualState x:Name="VisualStateNormal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource NormalMinWidth}" />
                    </VisualState.StateTriggers>
                    <!--<VisualState.Setters>
                          TODO: change properties for normal view  
                        <Setter Target="stateTextBox.Text" Value="Normal Visual State" />
                    </VisualState.Setters>-->
                </VisualState>
                <VisualState x:Name="VisualStateWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WideMinWidth}" />
                    </VisualState.StateTriggers>
                    <!--<VisualState.Setters>
                          TODO: change properties for wide view  
                        <Setter Target="stateTextBox.Text" Value="Wide Visual State" />
                    </VisualState.Setters>-->
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <controls:PageHeader x:Name="pageHeader" RelativePanel.AlignLeftWithPanel="True"
                             RelativePanel.AlignRightWithPanel="True"
                             RelativePanel.AlignTopWithPanel="True">

            <!--  secondary commands  -->
            <controls:PageHeader.SecondaryCommands>
                <AppBarButton Click="{x:Bind ViewModel.Hasardex}" Label="Hasardex" />
                <AppBarButton Click="{x:Bind ViewModel.GotoSettings}" Label="Paramètres" />
                <AppBarButton Click="{x:Bind ViewModel.GotoAbout}" Label="Infos" />
            </controls:PageHeader.SecondaryCommands>

            <controls:PageHeader.Content>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Bind ViewModel.PokedexName, Mode=OneWay}" VerticalAlignment="Center"/>
                    <AutoSuggestBox Margin="30,0,0,0" Width="220" QueryIcon="Find" PlaceholderText="Recherche" VerticalAlignment="Center" 
                                    Text="{x:Bind ViewModel.NameFilter, Mode=TwoWay}"/>
                </StackPanel>
            </controls:PageHeader.Content>
            
        </controls:PageHeader>

        
        <Grid x:Name="PokedexHeader"  Height="48" VerticalAlignment="Top"
              Background="{ThemeResource ButtonBackgroundThemeBrush}"
              RelativePanel.AlignLeftWithPanel="True"
              RelativePanel.AlignRightWithPanel="True"
              RelativePanel.Below="pageHeader">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="70" Text="#" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                <TextBlock Width="40" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />
                <TextBlock Width="170" Text="Nom" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                <TextBlock Width="100" Text="Type 1" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />
                <TextBlock Width="100" Text="Type 2" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                <Grid Width="60" Margin="40,0,0,0">
                    <TextBlock Text="PV" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Grid>
                <Grid Width="60">
                    <TextBlock Text="Atq" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Grid>
                <Grid Width="60">
                    <TextBlock Text="Déf" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Grid>
                <Grid Width="60">
                    <TextBlock Text="AtqSp" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Grid>
                <Grid Width="60">
                    <TextBlock Text="DéfSp" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Grid>
                <Grid Width="60">
                    <TextBlock Text="Vit" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Grid>
                <Grid Width="60">
                    <TextBlock Text="Total" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Grid>
            </StackPanel>
        </Grid>

        <ListView x:Name="gridView" 
                  ItemsSource="{x:Bind ViewModel.Pokemons, Mode=OneWay}"
                  SelectionMode="None"
                  RelativePanel.AlignLeftWithPanel="True"
                  RelativePanel.AlignRightWithPanel="True"
                  RelativePanel.AlignBottomWithPanel="True"
                  RelativePanel.Below="PokedexHeader">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Pokemon">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Tapped="PokemonItem_OnTapped">
                        <TextBlock Width="70" Text="{x:Bind PokedexNumberNationalFormatedWithSuffix}" VerticalAlignment="Center" FontWeight="Bold">
                            <ToolTipService.ToolTip>
                                <TextBlock>
                                    <Run Text="{x:Bind PokedexNumberNationalFormated}"/>
                                    <Run Text="{x:Bind Identifier}"/>
                                </TextBlock>
                            </ToolTipService.ToolTip>
                        </TextBlock>
                        <controls1:ImageEx Width="40" Source="{x:Bind FormKey, Converter={StaticResource FormKeyToIconPathConverter}}"
                                           VerticalAlignment="Center" Stretch="None" IsCacheEnabled="True"/>
                        <TextBlock Width="170" Text="{x:Bind Name}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                        <userControls:UserControlType Width="100" TypeId="{x:Bind Type1Id}" Text="{x:Bind Type1Name}"/>
                        <userControls:UserControlType Width="100" TypeId="{x:Bind Type2Id}" Text="{x:Bind Type2Name}" Margin="4,0,0,0"/>
                        <Grid Width="60" Margin="40,0,0,0">
                            <TextBlock Text="{x:Bind BaseStatHp, FallbackValue=100}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <Grid Width="60">
                            <TextBlock Text="{x:Bind BaseStatAtk, FallbackValue=100}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <Grid Width="60">
                            <TextBlock Text="{x:Bind BaseStatDef, FallbackValue=100}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <Grid Width="60">
                            <TextBlock Text="{x:Bind BaseStatAtkSpe, FallbackValue=100}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <Grid Width="60">
                            <TextBlock Text="{x:Bind BaseStatDefSpe, FallbackValue=100}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <Grid Width="60">
                            <TextBlock Text="{x:Bind BaseStatSpd, FallbackValue=100}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <Grid Width="60">
                            <TextBlock Text="{x:Bind BaseStatsTotal, FallbackValue=500}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </RelativePanel>
</Page>



